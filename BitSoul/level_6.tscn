[sub_resource type="GDScript" id="GDScript_sn8qy"]
script/source = "extends Label

@onready var label = $\".\"
var is_inverted = false

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	text = \"HP: \" + str($\"../../Player2/Player\".health) + \" %\"

func _on_invert_pressed() -> void:
	is_inverted = not is_inverted
	if is_inverted:
		label.add_theme_color_override(\"font_color\", Color(0, 0, 0))
	else:
		label.add_theme_color_override(\"font_color\", Color(1, 1, 1))

	var mat = $\"../../ScreenEffect\".material as ShaderMaterial
	mat.set_shader_parameter(\"invert\", is_inverted)
"

[sub_resource type="GDScript" id="GDScript_t2gkk"]
script/source = "extends Label

@onready var label = $\".\"
var is_inverted = false

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	text = \"Diamond: \" + str($\"../../Player2/Player\".diamond)


func _on_invert_pressed() -> void:
	is_inverted = not is_inverted
	if is_inverted:
		label.add_theme_color_override(\"font_color\", Color(0, 0, 0))
	else:
		label.add_theme_color_override(\"font_color\", Color(1, 1, 1))

	var mat = $\"../../ScreenEffect\".material as ShaderMaterial
	mat.set_shader_parameter(\"invert\", is_inverted)
"

